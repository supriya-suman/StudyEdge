# Copy this file to .env.local and paste your keys (never commit .env.local)
# One key is enough; with both, the lesson generator uses both side by side
# and the AI Mentor falls back to Groq when Gemini is busy.
GEMINI_API_KEY=paste-your-gemini-key
GROQ_API_KEY=paste-your-groq-key
# Optional model overrides
# GEMINI_MODEL=gemini-flash-latest
# GROQ_MODEL=openai/gpt-oss-120b
